---
---

@import "minimal-mistakes";

/* your landing page styles */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 80px 24px 120px;
  gap: 28px;
}

.hero-image-wrapper {
  width: 240px;
  height: 240px;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid #4c78a8;
  box-shadow: 0 0 40px rgba(76,120,168,0.28);
}

.hero-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.landing-content {
  max-width: 100%;
  margin: 0;
  padding: 0;
}

.hero {
  min-height: 100vh;
  justify-content: center;
}
